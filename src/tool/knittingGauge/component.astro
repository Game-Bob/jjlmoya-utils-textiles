---
import type { KnittingGaugeUI } from './ui';

interface Props {
  ui?: Record<string, unknown>;
}

const { ui = {} } = Astro.props;
const gaugeUI = ui as unknown as KnittingGaugeUI;
---

<div class="knitting-gauge-card" id="knitting-gauge-app">
  <aside class="gauge-sidebar">
    <div class="config-section">
      <h3>{gaugeUI.sectionOriginalGauge}</h3>
      <div class="input-grid">
        <div class="gauge-field">
          <label for="pattern-sts">{gaugeUI.labelStitches} <span class="label-sub">({gaugeUI.labelWidth})</span></label>
          <div class="stepper-container">
            <button class="stepper-btn" data-step="-0.5" data-for="pattern-sts">−</button>
            <input type="number" id="pattern-sts" class="gauge-input" value="20" step="0.5" />
            <button class="stepper-btn" data-step="0.5" data-for="pattern-sts">+</button>
          </div>
        </div>
        <div class="gauge-field">
          <label for="pattern-rows">{gaugeUI.labelRows} <span class="label-sub">({gaugeUI.labelLength})</span></label>
          <div class="stepper-container">
            <button class="stepper-btn" data-step="-0.5" data-for="pattern-rows">−</button>
            <input type="number" id="pattern-rows" class="gauge-input" value="28" step="0.5" />
            <button class="stepper-btn" data-step="0.5" data-for="pattern-rows">+</button>
          </div>
        </div>
      </div>
      <div class="gauge-field">
        <label for="gauge-unit">{gaugeUI.labelUnit}</label>
        <select id="gauge-unit" class="gauge-select">
          <option value="10">{gaugeUI.unitEU}</option>
          <option value="10.16">{gaugeUI.unitUS}</option>
        </select>
      </div>
    </div>

    <div class="config-section">
      <h3>{gaugeUI.sectionMyGauge}</h3>
      <div class="input-grid">
        <div class="gauge-field">
          <label for="my-sts">{gaugeUI.labelStitches} <span class="label-sub">({gaugeUI.labelWidth})</span></label>
          <div class="stepper-container">
            <button class="stepper-btn" data-step="-0.5" data-for="my-sts">−</button>
            <input type="number" id="my-sts" class="gauge-input" value="22" step="0.5" />
            <button class="stepper-btn" data-step="0.5" data-for="my-sts">+</button>
          </div>
        </div>
        <div class="gauge-field">
          <label for="my-rows">{gaugeUI.labelRows} <span class="label-sub">({gaugeUI.labelLength})</span></label>
          <div class="stepper-container">
            <button class="stepper-btn" data-step="-0.5" data-for="my-rows">−</button>
            <input type="number" id="my-rows" class="gauge-input" value="30" step="0.5" />
            <button class="stepper-btn" data-step="0.5" data-for="my-rows">+</button>
          </div>
        </div>
      </div>
      <div class="input-grid">
        <div class="gauge-field">
          <label for="my-needle">{gaugeUI.labelNeedleMm} <span class="label-sub">({gaugeUI.labelNeedle})</span></label>
          <input type="number" id="my-needle" class="gauge-input gauge-input-bordered" value="4.0" step="0.25" />
        </div>
        <div class="gauge-field">
          <label for="sample-weight">{gaugeUI.labelWeight} <span class="label-sub">{gaugeUI.labelWeightOptional}</span></label>
          <input type="number" id="sample-weight" class="gauge-input gauge-input-bordered" placeholder="5" />
        </div>
      </div>
    </div>

    <div class="config-section">
      <h3>{gaugeUI.sectionProject}</h3>
      <div class="input-grid">
        <div class="gauge-field">
          <label for="target-sts">{gaugeUI.labelPatternSts}</label>
          <input type="number" id="target-sts" class="gauge-input gauge-input-bordered" value="100" />
        </div>
        <div class="gauge-field">
          <label for="target-rows">{gaugeUI.labelPatternRows}</label>
          <input type="number" id="target-rows" class="gauge-input gauge-input-bordered" value="140" />
        </div>
      </div>
      <div class="gauge-field">
        <label for="pattern-multiples">{gaugeUI.labelMultiples} <span class="label-sub">{gaugeUI.labelMultiplesExample}</span></label>
        <input
          type="text"
          id="pattern-multiples"
          class="gauge-input gauge-input-bordered"
          placeholder={gaugeUI.labelMultiplesPlaceholder}
        />
      </div>
    </div>

    <div class="btn-group">
      <button id="btn-clear" class="ui-btn ui-btn-secondary">{gaugeUI.btnClear}</button>
      <button id="btn-share" class="ui-btn ui-btn-primary">{gaugeUI.btnShare}</button>
    </div>
  </aside>

  <main class="gauge-main">
    <div class="top-display">
      <div class="visualizer-container">
        <div id="gauge-visual-swatch" class="knit-swatch"></div>
      </div>
      <div class="main-stat">
        <h2>{gaugeUI.resSuggestedSts}</h2>
        <div class="val" id="res-total-sts">110</div>
        <div class="val-detail" id="res-multiples-note"></div>
        <div id="res-danger-info" class="alert-card alert-card-err"></div>
      </div>
    </div>

    <div class="metrics-grid">
      <div class="metric-item">
        <span class="sl">
          {gaugeUI.resNewRows}
          <i class="info-icon" data-tooltip={gaugeUI.resNewRowsTooltip}>i</i>
        </span>
        <div class="sv" id="res-total-rows">150</div>
      </div>
      <div class="metric-item">
        <span class="sl">
          {gaugeUI.resScaleFactor}
          <i class="info-icon" data-tooltip={gaugeUI.resScaleFactorTooltip}>i</i>
        </span>
        <div class="sv" id="res-scale-factor">+10%</div>
      </div>
      <div class="metric-item">
        <span class="sl">
          {gaugeUI.resSuggestion}
          <i class="info-icon" data-tooltip={gaugeUI.resSuggestionTooltip}>i</i>
        </span>
        <div class="sv sv-suggestion" id="res-size-suggestion"></div>
      </div>
    </div>

    <div id="yarn-estimate-box" class="yarn-calc-extra">
      <p class="yarn-title" id="yarn-title">{gaugeUI.yarnTitle}</p>
      <p id="yarn-result"></p>
    </div>

    <div id="res-multiples-info" class="alert-card alert-card-warn"></div>
  </main>
</div>

<script define:vars={{ ui }} is:inline>
  window.__knittingGaugeUI = ui;
</script>

<script>
  import type { KnittingGaugeUI } from './ui';

  declare global {
    interface Window {
      __knittingGaugeUI: KnittingGaugeUI;
    }
  }

  const INPUT_IDS = [
    'pattern-sts', 'pattern-rows', 'my-sts', 'my-rows',
    'target-sts', 'target-rows', 'pattern-multiples',
    'gauge-unit', 'my-needle', 'sample-weight',
  ] as const;

  let previousUnit = '10';

  function getNum(id: string): number {
    const el = document.getElementById(id) as HTMLInputElement | null;
    return parseFloat(el?.value || '0') || 0;
  }

  function getStr(id: string): string {
    const el = document.getElementById(id) as HTMLInputElement | null;
    return el?.value || '';
  }

  function setText(id: string, text: string): void {
    const el = document.getElementById(id);
    if (el) el.textContent = text;
  }

  function setHTML(id: string, html: string): void {
    const el = document.getElementById(id);
    if (el) el.innerHTML = html;
  }

  function showEl(id: string, visible: boolean): void {
    const el = document.getElementById(id);
    if (el) el.style.display = visible ? 'block' : 'none';
  }

  function parseMultiplesStr(str: string): { base: number; offset: number } {
    if (!str) return { base: 0, offset: 0 };
    const match = str.replace(/\s+/g, '').match(/(\d+)(?:\+(\d+))?/);
    if (!match) return { base: 0, offset: 0 };
    return { base: parseInt(match[1] ?? '0') || 0, offset: parseInt(match[2] ?? '0') || 0 };
  }

  function adjustForMultiples(raw: number, base: number, offset: number): number {
    const low = Math.floor((raw - offset) / base) * base + offset;
    const high = Math.ceil((raw - offset) / base) * base + offset;
    return Math.abs(raw - low) <= Math.abs(raw - high) ? low : high;
  }

  function buildSuggestionHTML(scaleDiff: number, needle: number): string {
    const u = window.__knittingGaugeUI;
    if (Math.abs(scaleDiff) < 2) {
      return `<span style="color:#10b981">${u.suggestionIdeal}</span>`;
    }
    const step = Math.ceil(Math.abs(scaleDiff) / 5) * 0.25;
    if (scaleDiff > 0) {
      const adj = Math.max(2, needle - step);
      const detail = u.suggestionDownDetail.replace('{n}', String(adj));
      return `${u.suggestionDown}<br><small style="opacity:0.7;font-weight:400">${detail}</small>`;
    }
    const adj = needle + step;
    const detail = u.suggestionUpDetail.replace('{n}', String(adj));
    return `${u.suggestionUp}<br><small style="opacity:0.7;font-weight:400">${detail}</small>`;
  }

  function computeStitches(patternSts: number, mySts: number, targetSts: number): number {
    const raw = Math.round(targetSts * mySts / patternSts);
    const { base, offset } = parseMultiplesStr(getStr('pattern-multiples'));
    if (base <= 0) {
      showEl('res-multiples-note', false);
      return raw;
    }
    const adj = adjustForMultiples(raw, base, offset);
    const label = offset > 0 ? `${base}+${offset}` : String(base);
    const note = window.__knittingGaugeUI.multiplesNoteFormat
      .replace('{n}', String(raw))
      .replace('{m}', label);
    setText('res-multiples-note', note);
    showEl('res-multiples-note', true);
    return adj;
  }

  function updateSwatch(patternSts: number, mySts: number): void {
    const swatch = document.getElementById('gauge-visual-swatch');
    if (!swatch) return;
    const scale = Math.min(Math.max(patternSts / mySts, 0.5), 1.3);
    const density = 12 * mySts / patternSts;
    swatch.style.transform = `scale(${scale})`;
    swatch.style.backgroundSize = `${density}px ${density}px`;
  }

  function updateYarnEstimate(weight: number, totalScale: number): void {
    if (weight <= 0) {
      showEl('yarn-estimate-box', false);
      return;
    }
    const grams = Math.ceil(weight * totalScale);
    const safety = Math.ceil(grams * 0.1);
    const u = window.__knittingGaugeUI;
    const result = u.yarnResultFormat.replace('{g}', String(grams));
    const safetyStr = u.yarnSafetyFormat.replace('{s}', String(safety));
    setHTML('yarn-result', `${result} <small>${safetyStr}</small>`);
    showEl('yarn-estimate-box', true);
  }

  function updateUrl(): void {
    const params = new URLSearchParams();
    INPUT_IDS.forEach((id) => {
      const el = document.getElementById(id) as HTMLInputElement | null;
      if (el?.value) params.set(id, el.value);
    });
    window.history.replaceState({}, '', `${window.location.pathname}?${params.toString()}`);
  }

  function calculate(): void {
    const patternSts = getNum('pattern-sts');
    const patternRows = getNum('pattern-rows');
    const mySts = getNum('my-sts');
    const myRows = getNum('my-rows');
    const targetSts = getNum('target-sts');
    const targetRows = getNum('target-rows');
    const weight = getNum('sample-weight');
    const needle = getNum('my-needle');
    if (!patternSts || !mySts) return;
    const finalSts = computeStitches(patternSts, mySts, targetSts);
    setText('res-total-sts', String(finalSts));
    setText('res-total-rows', String(Math.round(targetRows * myRows / patternRows)));
    const scaleDiff = (patternSts / mySts - 1) * 100;
    const sign = scaleDiff >= 0 ? '+' : '';
    setText('res-scale-factor', `${sign}${scaleDiff.toFixed(1)}%`);
    setHTML('res-size-suggestion', buildSuggestionHTML(scaleDiff, needle));
    showEl('res-danger-info', Math.abs(scaleDiff) > 25);
    if (Math.abs(scaleDiff) > 25) setText('res-danger-info', window.__knittingGaugeUI.alertDanger);
    updateSwatch(patternSts, mySts);
    updateYarnEstimate(weight, (targetSts / patternSts) * (targetRows / patternRows));
    updateUrl();
  }

  function handleUnitConversion(): void {
    const currentUnit = getStr('gauge-unit');
    if (currentUnit === previousUnit) return;
    const ratio = parseFloat(currentUnit) / parseFloat(previousUnit);
    ['pattern-sts', 'pattern-rows', 'my-sts', 'my-rows'].forEach((id) => {
      const el = document.getElementById(id) as HTMLInputElement | null;
      if (el?.value) el.value = (parseFloat(el.value) * ratio).toFixed(1);
    });
    previousUnit = currentUnit;
    calculate();
  }

  function handleClear(): void {
    INPUT_IDS.forEach((id) => {
      if (id === 'gauge-unit') return;
      const el = document.getElementById(id) as HTMLInputElement | null;
      if (!el) return;
      el.value = (el.id.includes('sts') || el.id.includes('rows')) ? '20' : '';
    });
    calculate();
  }

  function handleShare(): void {
    navigator.clipboard.writeText(window.location.href);
    const btn = document.getElementById('btn-share');
    if (!btn) return;
    const orig = btn.textContent;
    btn.textContent = window.__knittingGaugeUI.btnCopied;
    setTimeout(() => { if (btn) btn.textContent = orig; }, 2000);
  }

  function restoreFromUrl(): void {
    const params = new URLSearchParams(window.location.search);
    params.forEach((val, key) => {
      const el = document.getElementById(key) as HTMLInputElement | null;
      if (el) el.value = val;
    });
    previousUnit = getStr('gauge-unit') || '10';
  }

  function attachStepperListeners(): void {
    document.querySelectorAll('.stepper-btn').forEach((btn) => {
      btn.addEventListener('click', (ev) => {
        const target = ev.currentTarget as HTMLButtonElement;
        const forId = target.getAttribute('data-for') || '';
        const step = parseFloat(target.getAttribute('data-step') || '1');
        const input = document.getElementById(forId) as HTMLInputElement | null;
        if (input) {
          input.value = String(parseFloat(input.value || '0') + step);
          calculate();
        }
      });
    });
  }

  function init(): void {
    restoreFromUrl();
    attachStepperListeners();
    const unitSel = document.getElementById('gauge-unit');
    if (unitSel) unitSel.addEventListener('change', handleUnitConversion);
    INPUT_IDS.forEach((id) => {
      const el = document.getElementById(id);
      if (el) el.addEventListener('input', calculate);
    });
    document.getElementById('btn-clear')?.addEventListener('click', handleClear);
    document.getElementById('btn-share')?.addEventListener('click', handleShare);
    calculate();
  }

  document.addEventListener('astro:page-load', init);
  init();
</script>

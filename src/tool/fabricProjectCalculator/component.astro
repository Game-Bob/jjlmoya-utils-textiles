---
import type { FabricProjectCalculatorUI } from './ui';

interface Props {
  ui?: Record<string, unknown>;
}

const { ui = {} } = Astro.props;
const calcUI = ui as FabricProjectCalculatorUI;
---

<div class="fabric-calculator-card" id="fabric-calc-app">
  <div class="fabric-sidebar">
    <div class="config-group">
      <h3>{calcUI.sectionProject}</h3>
      <div class="fabric-field">
        <label>{calcUI.labelGarmentType}</label>
        <select id="garment-type" class="fabric-select">
          <option value="skirt">{calcUI.garmentSkirt}</option>
          <option value="pants">{calcUI.garmentPants}</option>
          <option value="dress">{calcUI.garmentDress}</option>
          <option value="shirt">{calcUI.garmentShirt}</option>
          <option value="coat">{calcUI.garmentCoat}</option>
          <option value="tote">{calcUI.garmentTote}</option>
        </select>
      </div>
      <div class="fabric-field">
        <label>{calcUI.labelSize}</label>
        <div class="preset-group" id="size-presets">
          <button class="preset-pill" data-val="xs_core">{calcUI.sizeXS}</button>
          <button class="preset-pill active" data-val="m_core">{calcUI.sizeM}</button>
          <button class="preset-pill" data-val="xl_core">{calcUI.sizeXL}</button>
        </div>
      </div>
    </div>

    <div class="config-group">
      <h3>{calcUI.sectionMaterial}</h3>
      <div class="fabric-field">
        <label>{calcUI.labelFabricWidth}</label>
        <select id="fabric-width" class="fabric-select">
          <option value="90">{calcUI.width90}</option>
          <option value="115">{calcUI.width115}</option>
          <option value="140" selected>{calcUI.width140}</option>
          <option value="150">{calcUI.width150}</option>
        </select>
      </div>
      <div class="fabric-field">
        <label>{calcUI.labelSeamAllowance}</label>
        <div class="shop-stepper">
          <button class="step-btn" id="sub-allow">−</button>
          <input type="number" id="seam-allowance" class="fabric-input" value="1.5" step="0.5" min="0" max="5" />
          <button class="step-btn" id="add-allow">+</button>
        </div>
      </div>
    </div>

    <div class="btn-actions">
      <button id="btn-clear-f" class="f-btn f-seco">{calcUI.btnClear}</button>
      <button id="btn-share-f" class="f-btn f-prim">{calcUI.btnShare}</button>
    </div>
  </div>

  <main class="fabric-main">
    <div id="warning-msg" class="warning-banner"></div>

    <section class="magic-result-area">
      <span class="result-lbl">{calcUI.resultLabel}</span>
      <div class="val"><span id="main-meters">1.40</span><span class="unit">{calcUI.resultUnit}</span></div>
      <div class="advice-tag" id="shop-advice"></div>
    </section>

    <div class="layout-container">
      <div class="canvas-wrapper">
        <div class="scheme-area">
          <div class="ruler" id="ruler-col"></div>
          <div id="fabric-board-box" class="fabric-board">
            <div class="board-empty-state">{calcUI.boardEmpty}</div>
          </div>
        </div>
        <div class="scheme-info" id="board-desc"></div>
      </div>
    </div>

    <section class="merch-section">
      <div class="merch-header">
        <h3 class="merch-title">{calcUI.merchTitle}</h3>
        <button id="copy-list-btn" class="copy-list-btn">{calcUI.btnCopyList}</button>
      </div>
      <ul id="check-list" class="merceria-checklist"></ul>
    </section>
  </main>
</div>

<script define:vars={{ ui }} is:inline>
  window.__toolUI = ui;
</script>

<script>
  import type { FabricProjectCalculatorUI } from './ui';
  import type { PieceRow } from './logic';
  import {
    isSerialCut, computeMeters, shopAdviceMeters, getRulerStep,
    PIECE_ROWS, CONSUMPTION_MATRIX, SIZE_MULTS, SIZE_MIN_WIDTHS,
  } from './logic';

  declare global {
    interface Window {
      __toolUI: FabricProjectCalculatorUI;
    }
  }

  type PieceNameKey = keyof FabricProjectCalculatorUI['pieceNames'];

  const PIECE_COLORS = [
    'rgba(196, 181, 253, 0.55)',
    'rgba(165, 180, 252, 0.55)',
    'rgba(139, 92, 246, 0.30)',
    'rgba(167, 139, 250, 0.45)',
    'rgba(129, 140, 248, 0.45)',
    'rgba(110, 231, 183, 0.40)',
  ];

  const PIECE_BORDERS = [
    'rgba(139, 92, 246, 0.50)',
    'rgba(99, 102, 241, 0.50)',
    'rgba(139, 92, 246, 0.70)',
    'rgba(124, 58, 237, 0.50)',
    'rgba(79, 70, 229, 0.50)',
    'rgba(16, 185, 129, 0.50)',
  ];

  let activeSize = 'm_core';

  function getNum(id: string): number {
    const el = document.getElementById(id) as HTMLInputElement | null;
    return parseFloat(el?.value || '0') || 0;
  }

  function getStr(id: string): string {
    const el = document.getElementById(id) as HTMLInputElement | null;
    return el?.value || '';
  }

  function setText(id: string, text: string): void {
    const el = document.getElementById(id);
    if (el) el.textContent = text;
  }

  function flashBtn(id: string, flashText: string): void {
    const btn = document.getElementById(id);
    if (!btn) return;
    const orig = btn.textContent;
    btn.textContent = flashText;
    setTimeout(() => { if (btn) btn.textContent = orig; }, 2000);
  }

  function buildPieceEl(nameKey: string, w: number, fold: boolean, col: number): HTMLDivElement {
    const el = document.createElement('div');
    el.className = `piece-block${fold ? ' piece-fold' : ''}`;
    el.style.width = `${w * 100}%`;
    el.style.background = PIECE_COLORS[col];
    el.style.borderColor = PIECE_BORDERS[col];
    const nameEl = document.createElement('span');
    nameEl.className = 'piece-name';
    nameEl.textContent = window.__toolUI.pieceNames[nameKey as PieceNameKey] || nameKey;
    el.appendChild(nameEl);
    if (fold) {
      const foldEl = document.createElement('div');
      foldEl.className = 'fold-indicator';
      foldEl.textContent = window.__toolUI.foldLabel;
      el.appendChild(foldEl);
    }
    return el;
  }

  function buildRowEl(row: PieceRow): HTMLDivElement {
    const rowEl = document.createElement('div');
    rowEl.className = 'piece-row';
    rowEl.style.flex = `0 0 ${row.h * 100}%`;
    row.pieces.forEach((spec) => {
      rowEl.appendChild(buildPieceEl(spec.nameKey, spec.w, spec.fold ?? false, spec.col));
    });
    return rowEl;
  }

  function renderBoard(type: string, board: HTMLElement): void {
    board.innerHTML = '';
    const rows = PIECE_ROWS[type];
    if (!rows?.length) {
      const empty = document.createElement('div');
      empty.className = 'board-empty-state';
      empty.textContent = window.__toolUI.boardEmpty;
      board.appendChild(empty);
      return;
    }
    rows.forEach((row) => board.appendChild(buildRowEl(row)));
  }

  function renderRuler(totalMeters: number): void {
    const ruler = document.getElementById('ruler-col');
    if (!ruler) return;
    ruler.innerHTML = '';
    const step = getRulerStep(totalMeters);
    let mark = 0;
    while (mark <= totalMeters + 0.001) {
      const markEl = document.createElement('div');
      markEl.className = 'ruler-mark';
      markEl.style.top = `${(mark / totalMeters) * 100}%`;
      const label = document.createElement('span');
      label.textContent = `${mark.toFixed(step < 0.5 ? 2 : 1)}m`;
      markEl.appendChild(label);
      ruler.appendChild(markEl);
      mark = parseFloat((mark + step).toFixed(3));
    }
  }

  function renderLayout(type: string, width: number, meters: number): void {
    const board = document.getElementById('fabric-board-box');
    if (!board) return;
    renderBoard(type, board);
    renderRuler(meters);
    const desc = document.getElementById('board-desc');
    if (desc) {
      desc.textContent = window.__toolUI.boardDescFormat
        .replace('{w}', String(width))
        .replace('{m}', meters.toFixed(2));
    }
  }

  function updateWarning(serial: boolean, width: string): void {
    const el = document.getElementById('warning-msg');
    if (!el) return;
    el.style.display = serial ? 'block' : 'none';
    if (serial) el.textContent = window.__toolUI.warningSerialFormat.replace('{w}', width);
  }

  function updateResult(meters: number): void {
    setText('main-meters', meters.toFixed(2));
    const store = shopAdviceMeters(meters);
    const advice = document.getElementById('shop-advice');
    if (advice) advice.textContent = window.__toolUI.shopAdviceFormat.replace('{m}', store.toFixed(2));
  }

  function updateChecklist(type: string): void {
    const checks = document.getElementById('check-list');
    if (!checks) return;
    const u = window.__toolUI;
    const extra = u.garmentMerceria[type as keyof typeof u.garmentMerceria] || '';
    const extras = extra.split(',').map((s) => s.trim()).filter(Boolean);
    const items = [u.checklistThread, ...extras];
    checks.innerHTML = '';
    items.forEach((text) => {
      const li = document.createElement('li');
      li.className = 'merch-item';
      li.innerHTML = `<span class="merch-dot" aria-hidden="true">◆</span>${text}`;
      checks.appendChild(li);
    });
  }

  function updateUrl(): void {
    const p = new URLSearchParams();
    p.set('g', getStr('garment-type'));
    p.set('s', activeSize);
    p.set('w', getStr('fabric-width'));
    p.set('a', getStr('seam-allowance'));
    window.history.replaceState({}, '', `${window.location.pathname}?${p.toString()}`);
  }

  function calculate(): void {
    const type = getStr('garment-type');
    const width = getStr('fabric-width');
    const allowCm = getNum('seam-allowance');
    const widthInt = parseInt(width);
    const base = CONSUMPTION_MATRIX[type]?.[width] || 1.5;
    const mult = SIZE_MULTS[activeSize] ?? 1.0;
    const minW = SIZE_MIN_WIDTHS[activeSize] ?? 55;
    const serial = isSerialCut(minW, widthInt, type);
    const meters = computeMeters(base, mult, serial, allowCm);
    updateWarning(serial, width);
    updateResult(meters);
    renderLayout(type, widthInt, meters);
    updateChecklist(type);
    updateUrl();
  }

  function handleSizeClick(e: Event): void {
    const btn = (e.target as HTMLElement).closest('.preset-pill');
    if (!btn) return;
    document.getElementById('size-presets')?.querySelectorAll('.preset-pill').forEach((b) => {
      b.classList.remove('active');
    });
    btn.classList.add('active');
    activeSize = btn.getAttribute('data-val') || 'm_core';
    calculate();
  }

  function stepAllowance(delta: number): void {
    const el = document.getElementById('seam-allowance') as HTMLInputElement | null;
    if (!el) return;
    const clamped = Math.min(5, Math.max(0, (parseFloat(el.value) || 1.5) + delta));
    el.value = String(clamped);
    calculate();
  }

  function handleClear(): void {
    const garment = document.getElementById('garment-type') as HTMLSelectElement | null;
    const width = document.getElementById('fabric-width') as HTMLSelectElement | null;
    const allow = document.getElementById('seam-allowance') as HTMLInputElement | null;
    if (garment) garment.value = 'skirt';
    if (width) width.value = '140';
    if (allow) allow.value = '1.5';
    activeSize = 'm_core';
    document.getElementById('size-presets')?.querySelectorAll('.preset-pill').forEach((b) => {
      b.classList.toggle('active', b.getAttribute('data-val') === 'm_core');
    });
    calculate();
  }

  function handleCopyList(): void {
    const checks = document.getElementById('check-list');
    const lines = Array.from(checks?.querySelectorAll('.merch-item') || [])
      .map((li) => '• ' + (li.textContent || '').replace('◆', '').trim());
    navigator.clipboard.writeText(lines.join('\n'));
    flashBtn('copy-list-btn', window.__toolUI.btnCopied);
  }

  function restoreEl(q: URLSearchParams, param: string, id: string, def: string): void {
    if (!q.has(param)) return;
    const el = document.getElementById(id) as HTMLInputElement | null;
    if (el) el.value = q.get(param) || def;
  }

  function restoreInputs(q: URLSearchParams): void {
    restoreEl(q, 'g', 'garment-type', 'skirt');
    restoreEl(q, 'w', 'fabric-width', '140');
    restoreEl(q, 'a', 'seam-allowance', '1.5');
  }

  function restoreSize(q: URLSearchParams): void {
    if (!q.has('s')) return;
    activeSize = q.get('s') || 'm_core';
    document.getElementById('size-presets')?.querySelectorAll('.preset-pill').forEach((b) => {
      b.classList.toggle('active', b.getAttribute('data-val') === activeSize);
    });
  }

  function attachListeners(): void {
    document.getElementById('size-presets')?.addEventListener('click', handleSizeClick);
    document.getElementById('sub-allow')?.addEventListener('click', () => stepAllowance(-0.5));
    document.getElementById('add-allow')?.addEventListener('click', () => stepAllowance(0.5));
    document.getElementById('btn-clear-f')?.addEventListener('click', handleClear);
    document.getElementById('btn-share-f')?.addEventListener('click', () => {
      navigator.clipboard.writeText(window.location.href);
      flashBtn('btn-share-f', window.__toolUI.btnCopied);
    });
    document.getElementById('copy-list-btn')?.addEventListener('click', handleCopyList);
    ['garment-type', 'fabric-width', 'seam-allowance'].forEach((id) => {
      document.getElementById(id)?.addEventListener('input', calculate);
    });
  }

  function init(): void {
    const q = new URLSearchParams(window.location.search);
    restoreInputs(q);
    restoreSize(q);
    attachListeners();
    calculate();
  }

  document.addEventListener('astro:page-load', init);
  init();
</script>
